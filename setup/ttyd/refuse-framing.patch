 static int send_unauthorized(struct lws *wsi, unsigned int code, enum lws_token_indexes header) {
   unsigned char buffer[1024 + LWS_PRE], *p, *end;
   p = buffer + LWS_PRE;
   end = p + sizeof(buffer) - LWS_PRE;
 
-  if (lws_add_http_header_status(wsi, code, &p, end) ||
+  if (lws_add_http_header_status(wsi, code, &p, end) || add_frame_headers(wsi, &p, end) ||
       lws_add_http_header_by_token(wsi, header, (unsigned char *)"Basic realm=\"ttyd\"", 18, &p, end) ||
       lws_add_http_header_content_length(wsi, 0, &p, end) || lws_finalize_http_header(wsi, &p, end) ||
       lws_write(wsi, buffer + LWS_PRE, p - (buffer + LWS_PRE), LWS_WRITE_HTTP_HEADERS) < 0)
@@ -25,6 +36,18 @@ static int send_unauthorized(struct lws *wsi, unsigned int code, enum lws_token_
   return lws_http_transaction_completed(wsi) ? AUTH_FAIL : AUTH_ERROR;
 }
 
+// send_not_found answers 404 with no body. It is used instead of
+// lws_return_http_status, which can't add the framing headers.
+static int send_not_found(struct lws *wsi) {
+  unsigned char buffer[1024 + LWS_PRE], *p, *end;
+  p = buffer + LWS_PRE;
+  end = p + sizeof(buffer) - LWS_PRE;
+
+  return lws_add_http_header_status(wsi, HTTP_STATUS_NOT_FOUND, &p, end) || add_frame_headers(wsi, &p, end) ||
+         lws_add_http_header_content_length(wsi, 0, &p, end) || lws_finalize_http_header(wsi, &p, end) ||
+         lws_write(wsi, buffer + LWS_PRE, p - (buffer + LWS_PRE), LWS_WRITE_HTTP_HEADERS) < 0;
+}
