+// set_credential stores credential (username:password) base64 encoded, as
+// clients send it in the Authorization header.
+static bool set_credential(const char *credential) {
+  if (strchr(credential, ':') == NULL) {
+    fprintf(stderr, "ttyd: invalid credential, format: username:password\n");
+    return false;
+  }
+  char b64_text[256];
+  if (lws_b64_encode_string(credential, (int)strlen(credential), b64_text, sizeof(b64_text)) < 0) {
+    fprintf(stderr, "ttyd: credential is too long\n");
+    return false;
+  }
+  if (server->credential != NULL) free(server->credential);
+  server->credential = strdup(b64_text);
+  return true;
+}
+
+// read_credential_file sets the credential from the first line of a file,
+// so it does not have to be given on the command line, where every user
+// who can list processes can read it.
+static bool read_credential_file(const char *path) {
+  FILE *fp = fopen(path, "r");
+  if (fp == NULL) {
+    fprintf(stderr, "ttyd: can not open credential file %s: %s\n", path, strerror(errno));
+    return false;
+  }
+  char buf[256];
+  bool ok = fgets(buf, sizeof(buf), fp) != NULL;
+  fclose(fp);
+  if (!ok) {
+    fprintf(stderr, "ttyd: can not read credential file %s\n", path);
+    return false;
+  }
+  size_t len = strlen(buf);
+  while (len && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) buf[--len] = '\0';
+  ok = set_credential(buf);
+  memset(buf, 0, sizeof(buf));
+  return ok;
+}
